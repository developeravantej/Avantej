{
  "sources": [
    {
      "name": "react-doctor-native",
      "cmd": "npx -y react-doctor@latest apps/native --json 2>/dev/null || true",
      "format": "react-doctor",
      "enabled": true
    },
    {
      "name": "tsc-native",
      "cmd": "bunx tsc -p apps/native/tsconfig.json --noEmit 2>&1",
      "format": "tsc-text",
      "enabled": true
    }
  ],
  "default_severity_filter": "warning"
}
