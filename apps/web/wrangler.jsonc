{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "avantej-core",
	"account_id": "a9c786e2839df3157985b75b9195a5dd",
	"compatibility_date": "2025-04-03",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	// Named "prod" environment = MOVE production web worker. Build with
	// VITE_SERVER_URL set to the prod server, then: wrangler deploy --env prod
	"env": {
		"prod": {
			"name": "avantej-core-web-prod",
			"assets": {
				"not_found_handling": "single-page-application"
			}
		}
	}
}
