# Journey-suite env — loaded ONLY by `vite --mode journeys` (see playwright.journeys.config.ts).
# Vite loads .env.<mode> only for that mode, so this does NOT affect normal `bun dev`
# (development mode), which keeps using apps/web/.env (VITE_SERVER_URL=:3020).
#
# Points the web client at the journey-suite server on :3000 (the suite boots its own
# wrangler/vite pair on free ports 3000/3001 to avoid other-worktree port conflicts).
VITE_SERVER_URL=http://localhost:3000
