{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3021",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:test": "playwright test --config playwright.config.ts",
    "e2e:test:real": "E2E_REAL_GHL=1 playwright test --config playwright.config.real.ts",
    "e2e:install": "playwright install chromium",
    "wrangler:dev": "wrangler dev --port=3022",
    "deploy": "CF_DEPLOY=true vite build && wrangler deploy",
    "deploy:prod": "VITE_SERVER_URL=https://api.avantej.com CF_DEPLOY=true vite build && wrangler deploy --name avantej-core-web-prod"
  },
