# Native app env - local dev
# Pick ONE URL based on your target device:

# LAN IP - works for iOS sim, Android emulator (LAN mode), physical devices on same WiFi
EXPO_PUBLIC_SERVER_URL=http://192.168.0.139:3000

# iOS simulator only
# EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Android emulator only - host loopback
# EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3000

EXPO_PUBLIC_ENV=development
