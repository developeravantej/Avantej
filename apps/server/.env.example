# Control Panel Database (platform metadata, routing)
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Tenant Database (for integration tests)
TENANT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better-Auth Configuration
# Generate a secret key (minimum 32 characters): openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# CORS Configuration
# Frontend URL that will access the API
CORS_ORIGIN=http://localhost:3001

# Encryption Key (for tenant connection string encryption)
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Neon API (for creating tenant projects)
# Get from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=your-neon-api-key

# Stripe (Avantej platform account, dev-shared sandbox per ADR-0012)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_...     # /webhooks/stripe/platform
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...      # /webhooks/stripe/connect

# Stripe SaaS Price IDs (set after running `bun stripe:seed` from apps/server)
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Web app URL — used in Stripe Checkout success_url / cancel_url + billing portal return_url
WEB_APP_URL=http://localhost:3001

# Resend (email sending)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Avantej Core
TEST_EMAIL_RECIPIENT=your-email@example.com
# Resend webhook signing secret (svix). Get from Resend dashboard → Webhooks →
# your endpoint. Required for /webhooks/resend signature verification.
RESEND_WEBHOOK_SECRET=whsec_...

# Google OAuth (for calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google-calendar/callback
