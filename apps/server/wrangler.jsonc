{
	"name": "avantej-core-server",
	"account_id": "a9c786e2839df3157985b75b9195a5dd",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-15",
	"workers_dev": true,
	"compatibility_flags": ["nodejs_compat"],
	// R2 bucket for offline payment-proof uploads (UAT §7). Bucket created on the
	// ZHIYUAN account 2026-06-23. Accessed in handlers via c.env.PROOFS_BUCKET.
	"r2_buckets": [
		{
			"binding": "PROOFS_BUCKET",
			"bucket_name": "avantej-payment-proofs"
		}
	],
	"vars": {
		"NODE_ENV": "production",
		"INSTALLMENTS_LOCK_ON_OPEN": "true",
		"CORS_ORIGIN": "https://avantej-core-web.zhiyuantech.workers.dev",
		"BETTER_AUTH_URL": "https://avantej-core-server.zhiyuantech.workers.dev",
		// Default sender when EMAIL_PROVIDER=cloudflare (domain onboarded on the account).
		"CLOUDFLARE_EMAIL_FROM": "noreply@send.avantej.com"
		// Add public environment variables here
		// Comma-separate CORS_ORIGIN if multiple frontends need access.
	},
	// Cloudflare Email Sending binding (env.EMAIL) — used only when
	// EMAIL_PROVIDER=cloudflare; default provider stays Resend.
	"send_email": [{ "name": "EMAIL" }],
	// For sensitive data, use:
	// wrangler secret put SECRET_NAME
	// Don't add secrets to "vars" - they're visible in the dashboard!
	//
	// Scheduled jobs (Plan C ADR-0021 + Plan E ADR-0023 / ADR-0026). All crons
	// dispatch into the `scheduled` export in src/index.ts. Capped at 5 to fit
	// the Workers Free plan limit; reconciliation runs alongside the installment
	// sweep at 02:00 UTC instead of its own 02:30 slot.
	//   - hourly: webhook backfill (Plan C C.1)
	//   - daily 01:00 UTC: tenant usage snapshot (Plan E E.2)
	//   - daily 02:00 UTC: installment sweep + nightly reconciliation (Plan C C.5 + Phase 4)
	//   - daily 03:00 UTC: hard-delete sweeper for overdue tenants (Plan E E.8)
	//   - daily 09:00 UTC: onboarding-stuck alert (Plan C C.6)
	//   - every 15 min: refresh stale sending-domain verification status (email)
	//   - daily 04:00 UTC: purge aged email_logs rows (email retention)
	"triggers": {
		"crons": [
			"0 * * * *",
			"0 1 * * *",
			"0 2 * * *",
			"0 3 * * *",
			"0 9 * * *",
			"*/15 * * * *",
			"0 4 * * *"
		]
	},
	// Named "prod" environment = the MOVE production worker (separate from the
	// top-level dev worker). Named envs do NOT inherit vars/bindings/triggers —
	// re-declared here. Deploy with: wrangler deploy --env prod
	"env": {
		"prod": {
			"name": "avantej-core-server-prod",
			"vars": {
				"NODE_ENV": "production",
				"INSTALLMENTS_LOCK_ON_OPEN": "true",
				// Per-tenant subdomains are reflected dynamically by getAllowedOrigin()
				// (any https://*.avantej.com). CORS_ORIGIN here is the canonical fallback
				// + outbound-link base (emails/invites). BETTER_AUTH_URL is the FIXED API
				// host that issues the shared .avantej.com session cookie.
				"CORS_ORIGIN": "https://app.avantej.com",
				"BETTER_AUTH_URL": "https://api.avantej.com",
				"CLOUDFLARE_EMAIL_FROM": "noreply@send.avantej.com"
			},
			"r2_buckets": [
				{
					"binding": "PROOFS_BUCKET",
					"bucket_name": "avantej-payment-proofs"
				}
			],
			"send_email": [{ "name": "EMAIL" }],
			"triggers": {
				"crons": [
					"0 * * * *",
					"0 1 * * *",
					"0 2 * * *",
					"0 3 * * *",
					"0 9 * * *",
					"*/15 * * * *",
					"0 4 * * *"
				]
			}
		}
	}
}
