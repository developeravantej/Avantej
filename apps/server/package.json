{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "wrangler dev --port=3000 --local-protocol=http --ip=0.0.0.0",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "SKIP_INTEGRATION_TESTS=true bun test",
    "test:unit": "SKIP_INTEGRATION_TESTS=true bun test --exclude '**/*.integration.test.ts'",
    "test:integration": "bun test src/**/*.integration.test.ts",
    "test:neon": "bun test src/services/neon.service.test.ts",
    "test:neon:integration": "bun test src/services/neon.service.integration.test.ts",
    "test:org:integration": "bun test src/tests/integration/org.test.ts",
    "test:email": "bun test src/lib/email.test.ts",
    "test:email:integration": "bun test src/lib/email.integration.test.ts",
    "test:auth": "bun test src/services/auth.service.test.ts",
    "test:auth:email": "bun test src/tests/integration/auth-email.test.ts",
    "backup:tenant": "bun run scripts/backup-tenant-tables.ts",
    "cleanup:test-projects": "bun run scripts/cleanup-test-projects.ts",
    "inspect-test-data": "bun run scripts/inspect-and-cleanup-test-data.ts",
    "inspect-test-data:inspect-only": "bun run scripts/inspect-and-cleanup-test-data.ts --inspect-only",
    "inspect-test-data:cleanup-only": "bun run scripts/inspect-and-cleanup-test-data.ts --cleanup-only",
    "stripe:seed": "bun run scripts/stripe-seed-saas-products.ts",
    "seed:dev-connect": "bun run scripts/seed-dev-connect.ts"
  },
  "dependencies": {
    "@avantej-core/api": "workspace:*",
    "@avantej-core/auth": "workspace:*",
    "@avantej-core/db": "workspace:*",
    "@avantej-core/services": "workspace:*",
    "@avantej-core/types": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "bcryptjs": "^3.0.3",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "resend": "^6.4.2",
    "stripe": "^19.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.13.11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.40.3"
  }
}
