{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "wrangler dev --port=3020 --local-protocol=http --ip=0.0.0.0",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "SKIP_INTEGRATION_TESTS=true bun test",
    "test:unit": "SKIP_INTEGRATION_TESTS=true bun test src/tests/unit/routers src/middleware src/lib src/cron src/routers/payments.test.ts src/routers/stripe-connect.test.ts",
    "test:unit:isolated": "bun run scripts/run-unit-isolated.ts",
    "test:integration": "bun test src/**/*.integration.test.ts",
    "test:integration:isolated": "bun run scripts/run-integration-isolated.ts",
    "audit:migrations": "bun run scripts/audit-migration-idempotency.ts",
    "audit:migrations:strict": "bun run scripts/audit-migration-idempotency.ts --strict",
    "reconcile:migrations": "bun run scripts/reconcile-tenant-migrations.ts",
    "reconcile:migrations:dry": "bun run scripts/reconcile-tenant-migrations.ts --dry-run",
    "test:neon": "bun test src/services/neon.service.test.ts",
    "test:neon:integration": "bun test src/services/neon.service.integration.test.ts",
    "test:org:integration": "bun test src/tests/integration/org.integration.test.ts",
    "test:email": "bun test src/lib/email.test.ts",
    "test:email:integration": "bun test src/lib/email.integration.test.ts",
    "test:auth": "bun test src/services/auth.service.test.ts",
    "test:auth:email": "bun test src/tests/integration/auth-email.integration.test.ts",
    "backup:tenant": "bun run scripts/backup-tenant-tables.ts",
    "cleanup:test-projects": "bun run scripts/cleanup-test-projects.ts",
    "cleanup:test-branches": "bun run scripts/cleanup-test-branches.ts",
    "inspect-test-data": "bun run scripts/inspect-and-cleanup-test-data.ts",
    "inspect-test-data:inspect-only": "bun run scripts/inspect-and-cleanup-test-data.ts --inspect-only",
    "inspect-test-data:cleanup-only": "bun run scripts/inspect-and-cleanup-test-data.ts --cleanup-only",
    "stripe:seed": "bun run scripts/stripe-seed-saas-products.ts",
    "seed:dev-connect": "bun run scripts/seed-dev-connect.ts"
  },
  "dependencies": {
    "@avantej-core/api": "workspace:*",
    "@avantej-core/auth": "workspace:*",
    "@avantej-core/db": "workspace:*",
    "@avantej-core/services": "workspace:*",
    "@avantej-core/types": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "bcryptjs": "^3.0.3",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "exceljs": "^4.4.0",
    "hono": "catalog:",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "resend": "^6.24.0",
    "stripe": "^19.2.0",
    "svix": "^1.86.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.11",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.127.0"
  }
}
