{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate:control-panel": {
			"cache": false
		},
		"db:generate:tenant": {
			"cache": false
		},
		"db:migrate:control-panel": {
			"cache": false
		},
		"db:migrate:tenant": {
			"cache": false
		},
		"db:studio:control-panel": {
			"cache": false,
			"persistent": true
		},
		"db:studio:tenant": {
			"cache": false,
			"persistent": true
		},
		"db:migrate-all-tenants": {
			"cache": false
		}
	}
}
