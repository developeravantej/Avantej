{
  "ignore": {
    "rules": [
      "react-doctor/rendering-hydration-mismatch-time",
      "react-doctor/rerender-state-only-in-handlers",
      "react-doctor/rendering-usetransition-loading",
      "react-doctor/rn-no-legacy-expo-packages"
    ],
    "files": [
      "**/node_modules/**",
      "**/.turbo/**",
      "**/dist/**",
      "**/.expo/**",
      "**/build/**",
      "**/.next/**",
      "**/routeTree.gen.ts",
      "**/*.gen.ts",
      "packages/db/src/migrations/**",
      "apps/native/ios/**",
      "apps/native/android/**"
    ],
    "overrides": [
      {
        "files": ["**/apps/web/src/components/ui/**", "apps/web/src/components/ui/**", "src/components/ui/**"],
        "rules": ["knip/exports", "knip/types"]
      }
    ]
  }
}
