{
  "name": "avantej-core",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@orpc/server": "^1.10.0",
      "@orpc/openapi": "^1.10.0",
      "@orpc/zod": "^1.10.0",
      "better-auth": "^1.3.28",
      "@better-auth/expo": "^1.3.28",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "@orpc/client": "^1.10.0"
    }
  },
  "scripts": {
    "check": "oxlint",
    "check:oxlint": "node node_modules/oxlint/dist/cli.js",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @avantej-core/db db:push",
    "db:studio": "turbo -F @avantej-core/db db:studio",
    "db:generate": "turbo -F @avantej-core/db db:generate",
    "db:migrate": "turbo -F @avantej-core/db db:migrate",
    "db:generate:control-panel": "turbo -F @avantej-core/db db:generate:control-panel",
    "db:generate:tenant": "turbo -F @avantej-core/db db:generate:tenant",
    "db:migrate:control-panel": "turbo -F @avantej-core/db db:migrate:control-panel",
    "db:migrate:tenant": "turbo -F @avantej-core/db db:migrate:tenant",
    "db:studio:control-panel": "turbo -F @avantej-core/db db:studio:control-panel",
    "db:studio:tenant": "turbo -F @avantej-core/db db:studio:tenant",
    "db:migrate-all-tenants": "turbo -F @avantej-core/db db:migrate-all-tenants",
    "gen:migrations": "bun scripts/gen-tenant-migrations.ts",
    "verify:migrations": "bun scripts/verify-migrations-generated.ts",
    "doctor": "bash scripts/doctor.sh all",
    "doctor:web": "bash scripts/doctor.sh web",
    "doctor:native": "bash scripts/doctor.sh native",
    "doctor:diff": "bash scripts/doctor.sh diff",
    "doctor:fix": "bash scripts/doctor.sh fix",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/fixes-verification.spec.ts --project=chromium",
    "e2e:seed": "cd apps/server && bun run scripts/seed-business-data.ts",
    "stripe:listen": "PORT=3020 bash apps/server/scripts/stripe-listen.sh connect",
    "stripe:listen:platform": "PORT=3020 bash apps/server/scripts/stripe-listen.sh platform",
    "format:check": "biome format .",
    "ci:verify-e2e-fixture": "node scripts/ci/verify-e2e-fixture.mjs",
    "codemod:require-permission-orpc": "node scripts/codemods/replace-require-permission-orpc.mjs",
    "codemod:tenant-procedure": "node scripts/codemods/migrate-tenant-procedure.mjs",
    "codemod:tenant-procedure:batch2": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=2",
    "codemod:tenant-procedure:batch3": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=3",
    "codemod:tenant-procedure:batch4": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=4",
    "codemod:tenant-procedure:batch5": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=5",
    "codemod:tenant-procedure:batch6": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=6",
    "codemod:tenant-procedure:batch7": "node scripts/codemods/migrate-tenant-procedure.mjs --batch=7",
    "codemod:drop-unused-require-permission": "node scripts/codemods/drop-unused-require-permission-import.mjs",
    "codemod:strip-tenant-guards": "node scripts/codemods/strip-redundant-tenant-guards.mjs",
    "codemod:add-org-context-guard": "node scripts/codemods/add-org-context-guard.mjs",
    "codemod:ensure-permission-import": "node scripts/codemods/ensure-require-permission-orpc-import.mjs",
    "codemod:remove-dead-tenant-member": "node scripts/codemods/remove-dead-require-tenant-member.mjs",
    "codemod:add-branch-guard": "node scripts/codemods/add-branch-guard.mjs",
    "codemod:add-optional-branch-guard": "node scripts/codemods/add-optional-branch-guard.mjs",
    "codemod:replace-inline-branch-guard": "node scripts/codemods/replace-inline-branch-guard.mjs",
    "codemod:replace-descendant-branch-guard": "node scripts/codemods/replace-descendant-branch-guard.mjs",
    "codemod:ensure-branch-guard-import": "node scripts/codemods/ensure-guard-branch-import.mjs",
    "ci:check-tenant-perimeter": "node scripts/ci/check-tenant-perimeter.mjs",
    "ci:check-router-index-loc": "node scripts/ci/check-router-index-loc.mjs",
    "ci:check-router-file-loc": "node scripts/ci/check-router-file-loc.mjs",
    "gen:router-type-stubs": "node scripts/extract-router-type-stubs.mjs",
    "codemod:split-router": "node scripts/split-router-by-marker.mjs",
    "refine:split-router-imports": "node scripts/refine-split-router-imports.mjs",
    "refine:members-imports": "node scripts/refine-members-imports.mjs",
    "refine:hierarchy-imports": "node scripts/refine-hierarchy-imports.mjs",
    "refine:invitations-imports": "node scripts/refine-invitations-imports.mjs",
    "refine:refunds-imports": "node scripts/refine-refunds-imports.mjs",
    "refine:members-ghl-type": "node scripts/dedupe-members-ghl-type.mjs"
  },
  "dependencies": {
    "boneyard-js": "^1.9.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.12"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": [
      "bun run check:oxlint --",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.2.22"
}
