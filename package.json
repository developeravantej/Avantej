{
  "name": "avantej-core",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@orpc/server": "^1.10.0",
      "@orpc/openapi": "^1.10.0",
      "@orpc/zod": "^1.10.0",
      "better-auth": "^1.3.28",
      "@better-auth/expo": "^1.3.28",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "@orpc/client": "^1.10.0"
    }
  },
  "scripts": {
    "check": "oxlint",
    "check:oxlint": "node node_modules/oxlint/dist/cli.js",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @avantej-core/db db:push",
    "db:studio": "turbo -F @avantej-core/db db:studio",
    "db:generate": "turbo -F @avantej-core/db db:generate",
    "db:migrate": "turbo -F @avantej-core/db db:migrate",
    "db:generate:control-panel": "turbo -F @avantej-core/db db:generate:control-panel",
    "db:generate:tenant": "turbo -F @avantej-core/db db:generate:tenant",
    "db:migrate:control-panel": "turbo -F @avantej-core/db db:migrate:control-panel",
    "db:migrate:tenant": "turbo -F @avantej-core/db db:migrate:tenant",
    "db:studio:control-panel": "turbo -F @avantej-core/db db:studio:control-panel",
    "db:studio:tenant": "turbo -F @avantej-core/db db:studio:tenant",
    "db:migrate-all-tenants": "turbo -F @avantej-core/db db:migrate-all-tenants",
    "gen:migrations": "bun scripts/gen-tenant-migrations.ts",
    "verify:migrations": "bun scripts/verify-migrations-generated.ts",
    "doctor": "bash scripts/doctor.sh all",
    "doctor:web": "bash scripts/doctor.sh web",
    "doctor:native": "bash scripts/doctor.sh native",
    "doctor:diff": "bash scripts/doctor.sh diff",
    "doctor:fix": "bash scripts/doctor.sh fix",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/fixes-verification.spec.ts --project=chromium",
    "e2e:seed": "cd apps/server && bun run scripts/seed-business-data.ts",
    "format:check": "biome format .",
    "ci:verify-e2e-fixture": "node scripts/ci/verify-e2e-fixture.mjs",
    "codemod:require-permission-orpc": "node scripts/codemods/replace-require-permission-orpc.mjs",
    "codemod:tenant-procedure": "node scripts/codemods/migrate-tenant-procedure.mjs"
  },
  "dependencies": {
    "boneyard-js": "^1.8.1",
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxlint": "^1.12.0",
    "tsdown": "^0.15.5",
    "turbo": "^2.5.4"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "bun run check:oxlint --"
  },
  "packageManager": "bun@1.2.22"
}
