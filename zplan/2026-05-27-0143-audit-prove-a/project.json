    "baseURL": "http://localhost:3021",
    "serverHealthUrl": "http://localhost:3020",
    "testDir": "./e2e",
    "configFile": "playwright.config.ts",
    "authStorageState": "e2e/.auth/tenant-admin.json",
    "authSetupMatch": "auth.setup.ts"
  },
  "db": {
