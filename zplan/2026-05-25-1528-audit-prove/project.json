{
  "$generatedBy": "audit-prove/scripts/detect-project.mjs",
  "stack": "Vite + TanStack Router (file-based routing), oRPC, Drizzle ORM, Better-Auth, Bun, Turborepo monorepo",
  "conventions": "TypeScript-first; oRPC client at @/utils/orpc; route files under apps/web/src/routes/_authenticated/dashboard/_layout/; TanStack Form for new forms; shadcn/ui components; Tailwind CSS",
  "packageManager": "bun",
  "monorepo": true,
  "buildGate": {
    "command": "bun run check-types",
    "supportsFilter": false,
    "extraChecks": []
  },
  "apiSurface": {
    "routerGlobs": [
      "packages/api/src/routers/**/*.ts",
      "apps/server/src/routers/**/*.ts"
    ],
    "serviceGlobs": [
      "packages/services/src/**/*.ts"
    ]
  },
  "routes": {
    "routeGlobs": [
      "apps/web/src/routes/**/*.tsx"
    ],
    "clientPattern": "@/utils/orpc"
  },
  "hub": {
    "index": "zhub/index.md",
    "apiOverview": "zhub/shared/api-overview.md",
    "pagesDir": "zhub/pages"
  },
  "e2e": {
    "testDir": "./e2e",
    "baseURL": "http://avantej.localhost:3021",
    "authStorageState": "e2e/.auth/tenant-admin.json",
    "setupTestMatch": "auth.setup.ts",
    "devServerCommand": "bun run dev",
    "specName": "gap-prove"
  },
  "domainStrategy": "auto",
  "remediation": {
    "enabled": true,
    "scope": "full",
    "maxIterations": 6,
    "maxFixesPerTarget": 3,
    "stopOnNoProgress": true,
    "branch": "audit-prove/remediation",
    "parallelFixAgents": 3,
    "fixPolicy": {
      "latitude": "touched-path",
      "flagLargeRefactorsAs": "deferred-finding"
    }
  },
  "db": {
    "enabled": true,
    "verifyMode": "auto",
    "runner": "bun",
    "connectionEnv": "DATABASE_URL",
    "devVarsFile": "apps/server/.dev.vars",
    "verifyHelper": "apps/server/src/tests/helpers/integration-setup.ts",
    "multiTenant": true,
    "testOrgId": "996febce-aaad-4ded-8f47-02d2b566c8ee"
  }
}
