{"nodes": [{"id": "adr-0007-customer-payment-ux-paymentsheet", "label": "ADR 0007: Customer Payment UX \u2014 Stripe PaymentSheet (RN SDK) with Server-Side Finalization", "file_type": "rationale", "source_file": "docs/adr/0007-customer-payment-ux-paymentsheet.md", "source_location": null, "source_url": null, "captured_at": "2026-05-13", "author": null, "contributor": null, "rationale": "Use Stripe PaymentSheet from @stripe/stripe-react-native for card collection. Server creates PaymentIntent on the tenant's connected account; finalization (package_instance creation, ledger mirror) happens in the payment_intent.succeeded webhook, not on client return. UUID idempotency key prevents double-charges. Done page polls for webhook materialization.", "status": "Accepted", "alternatives_rejected": ["Stripe Checkout redirect (breaks native flow)", "Custom UI with CardField (higher cost, no UX win)", "Client-side finalization (unreliable on disconnect)"]}, {"id": "concept-stripe-paymentsheet", "label": "Stripe PaymentSheet (React Native SDK)", "file_type": "document", "source_file": "docs/adr/0007-customer-payment-ux-paymentsheet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "adr-0007-customer-payment-ux-paymentsheet", "target": "concept-stripe-paymentsheet", "relation": "DECIDES_TO_USE", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-customer-payment-ux-paymentsheet.md", "source_location": null, "weight": 1.0}, {"source": "adr-0007-customer-payment-ux-paymentsheet", "target": "concept-platform-payment-ledger", "relation": "WRITES_TO_ON_WEBHOOK", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-customer-payment-ux-paymentsheet.md", "source_location": null, "weight": 0.8}, {"source": "adr-0007-customer-payment-ux-paymentsheet", "target": "adr-0014-refund-snapshot-pattern", "relation": "PRECEDES_SNAPSHOT_PATTERN_NEED", "confidenc